# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (Neon, Supabase or local Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/race_control

# Server
PORT=4000
# Public URL of the server, used in the hook snippets developers copy
PUBLIC_URL=http://localhost:4000

# Web app. Magic links point here.
WEB_URL=http://localhost:5173
