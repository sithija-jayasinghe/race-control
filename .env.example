# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (Neon, Supabase or local Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/race_control

# Server
PORT=4000
# Proxies in front of the server. 0 locally; 1 on Render, so rate limits see each person's own IP.
TRUST_PROXY=0
# Public URL of the server, used in the hook snippets developers copy
PUBLIC_URL=http://localhost:4000

# Web app. Magic links point here.
WEB_URL=http://localhost:5173

# Production only: the built web app, which this server then serves itself (one address for
# everything, so set WEB_URL and PUBLIC_URL to it). Leave empty in development, where Vite serves it.
WEB_DIST=

# Sign-in emails, sent with Resend (https://resend.com). Set both, or leave both empty to print magic links
# to the server console instead (development only; required in production). EMAIL_FROM must be on a domain
# you've verified in Resend; without one, Resend only delivers to your own address.
RESEND_API_KEY=
EMAIL_FROM=

# Sign in with GitHub and Google (optional; each is on when both of its values are set).
# Callback URL for both: WEB_URL/api/auth/github/callback and WEB_URL/api/auth/google/callback
# (http://localhost:5173/api/auth/... in development). See the README.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
