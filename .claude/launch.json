{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@race-control/server", "dev"],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@race-control/web", "dev"],
      "port": 5173
    },
    {
      "name": "server-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@race-control/server", "dev"],
      "port": 4001
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_SERVER_URL=http://127.0.0.1:4001",
        "pnpm",
        "--filter",
        "@race-control/web",
        "dev",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    }
  ]
}
