{
  "name": "race-control",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "simulate": "pnpm --filter @race-control/server run simulate",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
